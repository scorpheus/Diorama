{
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/passeur/passeur.ps1\" -Lancer || true",
            "async": true
          }
        ]
      }
    ]
  }
}
